# Virtual environment
.venv/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Build and packaging
build/
dist/
*.egg-info/
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers and linters
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# SharedBrain checkpoint (The Egg)
shared_brain.pkl

# Experiment outputs (each run writes its own folder)
runs/

# Markdown stays local: tracked in the separate .git-notes repo, never pushed.
# Only README files are part of the public repo.
*.md
!README.md
.git-notes/
.md_backup/
